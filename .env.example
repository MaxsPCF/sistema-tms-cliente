# Example environment variables for the backend
# Copy this file to `.env` and fill real secrets — do NOT commit `.env`.

# Database (SQL Server)
# Example: jdbc:sqlserver://localhost:1433;databaseName=TransporteCargaPesada;encrypt=false;trustServerCertificate=true
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=TransporteCargaPesada;encrypt=false;trustServerCertificate=true
DB_USERNAME=usr-desarrollo
DB_PASSWORD=change_me

# Server
SERVER_PORT=7137

# JWT / Security
# IMPORTANT: Replace with a secure secret and keep it out of version control
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRACION_MINUTOS=60

# Rate limiting
RATE_LIMIT_CAPACIDAD=60
RATE_LIMIT_REFILL=60


# URL base de la API REST del backend (.NET) - SIN slash final
# Ejemplo real: https://localhost:7000/api/v1  ->  login: /Authenticate/login
VITE_API_BASE_URL=https://localhost:7000/api/v1

# Modo mock: usa datos simulados cuando el backend aún no está disponible.
# Cambiar a "false" para consumir el backend real.
VITE_USE_MOCK_API=true

VITE_APP_NAME=TMS-Cliente - Transporte Carga Pesada


