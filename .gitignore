**/target/
**/test-classes/
**/generated-sources/
**/generated-test-sources/
dependency-reduced-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log
logs/

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Environment / secrets
.env
env.local
*.jks
*.keystore
*.p12
*.pem
secrets.*

# Coverage / reports
coverage/
target/site/

# Misc
*.class
*.war
*.ear
*.jar
*.log
